# Kopieer dit bestand naar .env en vul de waarden in (Supabase-dashboard → Project Settings → API).
# Deze twee waarden zijn publiek (ze komen in de frontend-bundle); de beveiliging zit in RLS.
VITE_SUPABASE_URL=https://jouw-project-ref.supabase.co
# De "anon" key, of de nieuwere "publishable" key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# LET OP: zet GEEN geheimen met het prefix VITE_ in dit bestand; die komen in de browser terecht.
# De Gemini API-sleutel hoort alleen in Supabase secrets (zie README), niet hier.
